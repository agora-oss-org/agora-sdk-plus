{
  "name": "@agora-sdk/secure-chat-react-js",
  "version": "0.11.1",
  "private": false,
  "license": "Apache-2.0",
  "author": "Agora SDK Plus, maintained by Jenova Marie",
  "description": "Web (browser) bindings for Agora secure chat: real MLS crypto (ts-mls) + IndexedDB persistence. Re-exports @agora-sdk/secure-chat-core.",
  "keywords": [
    "agora",
    "secure-chat",
    "e2ee",
    "mls",
    "react",
    "web",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/agora-oss-org/agora-sdk-plus/issues"
  },
  "homepage": "https://github.com/agora-oss-org/agora-sdk-plus",
  "repository": {
    "type": "git",
    "url": "https://github.com/agora-oss-org/agora-sdk-plus.git",
    "directory": "packages/secure-chat/react-js"
  },
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "type": "module",
  "comment:esm-only": "ESM-only: this web binding depends on the ESM-only @agora-sdk/secure-chat-crypto/ts-mls core, so a CJS build would never load at runtime. Web/React consumers always bundle (Vite/webpack/Metro) anyway.",
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "rimraf dist && pnpm run build:esm && pnpm run copy:docs",
    "prepublish": "pnpm run build",
    "copy:docs": "cp ../../../docs/SECURE-CHAT.md ./SECURE-CHAT.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "SECURE-CHAT.md"
  ],
  "dependencies": {
    "@agora-sdk/secure-chat-core": "workspace:*",
    "@agora-sdk/secure-chat-crypto": "workspace:*",
    "@noble/hashes": "2.0.1"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  }
}
