{
  "name": "@agora-sdk/secure-chat-react-native",
  "version": "0.9.3",
  "private": false,
  "license": "Apache-2.0",
  "author": "Agora SDK Plus, maintained by Jenova Marie",
  "description": "Bare React Native bindings for Agora secure chat: native MLS + Keychain. Re-exports @agora-sdk/secure-chat-core. (Phase 3 — stub.)",
  "keywords": [
    "agora",
    "secure-chat",
    "e2ee",
    "mls",
    "react-native",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/agora-oss-org/agora-sdk-plus/issues"
  },
  "homepage": "https://github.com/agora-oss-org/agora-sdk-plus",
  "repository": {
    "type": "git",
    "url": "https://github.com/agora-oss-org/agora-sdk-plus.git",
    "directory": "packages/secure-chat/react-native"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "type": "module",
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build": "rimraf dist && pnpm run build:esm && pnpm run build:cjs",
    "prepublish": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agora-sdk/secure-chat-core": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  }
}
