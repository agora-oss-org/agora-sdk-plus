# Agora SDK Plus — environment for the opt-in e2e suites (`pnpm test:e2e`).
#
# Copy to `.env` (gitignored) and fill in. The default `pnpm test` (unit suite) and CI
# need NONE of this. There are TWO suites with INDEPENDENT gates — set only what you
# need: secure-chat is skipped unless AGORA_E2E_DATABASE_URL is set, and public-read is
# skipped unless AGORA_E2E_PUBLIC_PROJECT_ID is set.
# direnv users: an `.envrc` containing `dotenv` auto-loads this file.

# ── Required for the SECURE-CHAT suite ──────────────────────────────────────
# Postgres URL the e2e seeds its throwaway project/users into. This MUST be the
# SAME database the agora-server you're testing against is ACTUALLY running on —
# i.e. the server's DATABASE_URL while `pnpm dev:api` is up (normally its DEV db).
# It is NOT the server's own test database (the one agora-server uses for its
# internal test suite). If this points anywhere the running server doesn't read,
# every secure-chat request 404s (the seeded project is invisible to the server).
AGORA_E2E_DATABASE_URL="postgresql://user:pass@host:6543/postgres"

# The running server's ACCESS_TOKEN_SECRET — our minted bearer tokens must verify
# under it. Copy it verbatim from that server's `.env`; a mismatch fails auth.
AGORA_E2E_ACCESS_TOKEN_SECRET="<server ACCESS_TOKEN_SECRET>"

# ── Optional (defaults target a local server on :4000) ───────────────────────
# REST base URL including the /v7 version prefix.
# AGORA_E2E_BASE_URL="http://localhost:4000/v7"
# Socket.io origin (no namespace; the client appends /secure).
# AGORA_E2E_SOCKET_URL="http://localhost:4000"

# ── The PUBLIC-READ suite (independent gate; no DB access, no minted JWT) ────
# Project id holding a seeded internet-public anchor. Set this to run the
# anonymous /public/* e2e; leave it unset to skip that suite entirely.
# Seed the fixture with `pnpm seed` from agora-server/apps/api — it publishes an
# anchor through the real PATCH /entities/:id/visibility action.
# AGORA_E2E_PUBLIC_PROJECT_ID="11111111-1111-1111-1111-111111111111"

# The anchor's stable key. The entity uuid is generated per install, so the suite
# always resolves by foreignId rather than hardcoding one.
# AGORA_E2E_PUBLIC_FOREIGN_ID="homepage-comments"

# NOTE: this suite talks to the MAIN API (default :4000), not the standalone
# secure-chat process on :4002 — it shares AGORA_E2E_BASE_URL, so if you run both
# suites against different ports, run them in separate invocations.
