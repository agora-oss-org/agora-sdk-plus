# Agora SDK Plus — environment for the opt-in foundation e2e (`pnpm test:e2e`).
#
# Copy to `.env` (gitignored) and fill in. The default `pnpm test` (unit suite) and CI
# need NONE of this — the e2e is skipped entirely unless AGORA_E2E_DATABASE_URL is set.
# direnv users: an `.envrc` containing `dotenv` auto-loads this file.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres URL the e2e seeds its throwaway project/users into. This MUST be the
# SAME database the agora-server you're testing against is ACTUALLY running on —
# i.e. the server's DATABASE_URL while `pnpm dev:api` is up (normally its DEV db).
# It is NOT the server's own test database (the one agora-server uses for its
# internal test suite). If this points anywhere the running server doesn't read,
# every secure-chat request 404s (the seeded project is invisible to the server).
AGORA_E2E_DATABASE_URL="postgresql://user:pass@host:6543/postgres"

# The running server's ACCESS_TOKEN_SECRET — our minted bearer tokens must verify
# under it. Copy it verbatim from that server's `.env`; a mismatch fails auth.
AGORA_E2E_ACCESS_TOKEN_SECRET="<server ACCESS_TOKEN_SECRET>"

# ── Optional (defaults target a local server on :4000) ───────────────────────
# REST base URL including the /v7 version prefix.
# AGORA_E2E_BASE_URL="http://localhost:4000/v7"
# Socket.io origin (no namespace; the client appends /secure).
# AGORA_E2E_SOCKET_URL="http://localhost:4000"
